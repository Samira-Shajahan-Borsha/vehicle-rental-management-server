{
    "name": "vehicle-rental-management-server",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "start": "tsx ./src/server.ts",
        "dev": "tsx watch ./src/server.ts",
        "build": "tsc --noEmit",
        "start:prod": "npm run build && npm run start",
        "lint": "eslint ./src/**/*",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
        "db:migrate": "cross-env NODE_OPTIONS=--import=tsx knex migrate:latest --knexfile knexfile.ts",
        "db:migrate:rollback": "cross-env NODE_OPTIONS=--import=tsx knex migrate:rollback --knexfile knexfile.ts",
        "db:migrate:make": "cross-env NODE_OPTIONS=--import=tsx knex migrate:make --knexfile knexfile.ts",
        "db:seed": "cross-env NODE_OPTIONS=--import=tsx knex seed:run --knexfile knexfile.ts",
        "db:setup": "npm run db:migrate && npm run db:seed"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "joi": "^18.2.5",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.3.0",
        "pg": "^8.23.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^26.2.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "prettier": "^3.9.6",
        "tsx": "^4.23.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0"
    }
}
